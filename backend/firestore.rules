rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && me().active == true; }
    function isAdmin() { return isActive() && me().role in ['admin', 'super_admin']; }
    // Case managers use the admin console: they read everything needed for care coordination and manage
    // clients, eBinder documents and credentials, but cannot touch schedules, accounts, settings or the audit log.
    function isOffice() { return isActive() && me().role in ['admin', 'super_admin', 'case_manager']; }
    function isSuper() { return isActive() && me().role == 'super_admin'; }

    // Profiles: you can read your own; only admins create/change them (role changes included).
    match /users/{uid} {
      allow read: if isActive() && (request.auth.uid == uid || isOffice());
      // Only a super admin may create or change admin-level accounts; plain admins manage staff.
      allow create, update: if isSuper() || (isAdmin()
        && request.resource.data.role in ['staff', 'family_staff']
        && (resource == null || resource.data.role in ['staff', 'family_staff']));
      allow delete: if false; // deactivate with active=false instead
    }

    // Clients: admins manage; staff don't read this collection (shifts carry what they need).
    match /clients/{id} {
      allow read, write: if isOffice();
    }

    // Shifts: staff read only their own and may change only progress fields.
    match /shifts/{id} {
      allow read: if isActive() && (resource.data.staffId == request.auth.uid || isOffice());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isActive() && resource.data.staffId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'clockInAt', 'clockInLat', 'clockInLng', 'clockOutAt', 'tasks', 'note']) &&
        // Server-side clock-out gate: a real note is required. (Rules can't loop over the
        // task list, so the all-tasks-done check is enforced in the app.)
        (request.resource.data.status != 'completed' || request.resource.data.note.size() >= 10)
      );
    }

    // Announcements: everyone signed in reads; admins write.
    match /announcements/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Left-site alerts: staff may only create one about themselves; admins read/resolve.
    match /alerts/{id} {
      allow create: if isActive() && request.resource.data.staffId == request.auth.uid
                    && request.resource.data.type == 'left_site';
      allow read: if isOffice();
      allow update: if isAdmin();
    }

    // Training / certification / document expiries: staff read their own; admins manage.
    match /credentials/{id} {
      allow read: if isActive() && (resource.data.staffId == request.auth.uid || isOffice());
      allow write: if isOffice();
    }

    // Missed clock-in requests: staff file one for themselves (pending); only admins decide.
    match /missedClockIns/{id} {
      allow create: if isActive() && request.resource.data.staffId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow read: if isActive() && (resource.data.staffId == request.auth.uid || isOffice());
      allow update: if isAdmin();
    }

    // Device push tokens: each person writes only their own. Functions read them with admin rights.
    match /pushTokens/{uid} {
      allow create, update: if isActive() && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
      allow read, delete: if isActive() && request.auth.uid == uid;
    }

    // File manager. Each item stores *effective* access lists (own shares + inherited), computed
    // by the app when a share changes. Rules only look at those lists.
    function driveDoc(id) { return get(/databases/$(database)/documents/drive/$(id)).data; }
    function inList(list) { return request.auth.uid in list || ('role:' + me().role) in list; }
    match /drive/{id} {
      // Office roles can read the linked "Individuals" tree (client folders), because their eBinder documents mirror into it.
      allow read: if isSuper()
        || (isOffice() && (resource == null || resource.data.get('linked', false) == true))
        || (isActive() && inList(resource.data.viewers));
      // Staff may add a file only into a folder where they have upload access, inheriting its access.
      allow create: if isSuper() || (isActive()
        && request.resource.data.type == 'file'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.parentId != null
        && inList(driveDoc(request.resource.data.parentId).uploaders)
        && request.resource.data.viewers == driveDoc(request.resource.data.parentId).viewers
        && request.resource.data.uploaders == driveDoc(request.resource.data.parentId).uploaders
        && request.resource.data.ownShares.size() == 0
        && request.resource.data.sharedRoot == false)
        // Office roles may create the linked client folders and the mirror of an eBinder upload (file manager <-> eBinder link).
        || (isOffice()
        && request.resource.data.get('linked', false) == true
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownShares.size() == 0
        && request.resource.data.sharedRoot == false
        && (request.resource.data.parentId == null
              ? (id == 'individuals' && request.resource.data.viewers.size() == 0 && request.resource.data.uploaders.size() == 0)
              : (driveDoc(request.resource.data.parentId).get('linked', false) == true
                 && request.resource.data.viewers == driveDoc(request.resource.data.parentId).viewers
                 && request.resource.data.uploaders == driveDoc(request.resource.data.parentId).uploaders)));
      allow update, delete: if isSuper();
    }

    // In-app notification inbox: written by Cloud Functions; people read their own and mark them read.
    match /notifications/{id} {
      allow read: if isActive() && resource.data.userId == request.auth.uid;
      allow update: if isActive() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Personal settings toggles.
    match /userPrefs/{uid} {
      allow read, write: if isActive() && request.auth.uid == uid;
    }

    // Agency profile (name, phone, address): everyone signed in can read it (staff app shows the office phone).
    match /settings/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // eBinder documents. Staff read what is shared with them; admins manage. Signatures and audit events are
    // create-only (never edited or deleted), stamped with the server clock, and bound to the signer's own uid.
    match /ebinderDocs/{id} {
      allow read: if isOffice() || (isActive() && (resource.data.audience == 'all_staff'
        || (resource.data.audience == 'assigned' && request.auth.uid in resource.data.assignedTo)));
      allow write: if isOffice();

      match /signatures/{sid} {
        allow read: if isOffice() || (isActive() && resource.data.staffId == request.auth.uid);
        allow create: if isActive()
          && request.resource.data.staffId == request.auth.uid
          && request.resource.data.signedAt == request.time
          && request.resource.data.version == get(/databases/$(database)/documents/ebinderDocs/$(id)).data.version
          && sid == request.auth.uid + '_v' + string(request.resource.data.version)
          && (get(/databases/$(database)/documents/ebinderDocs/$(id)).data.audience == 'all_staff'
              || request.auth.uid in get(/databases/$(database)/documents/ebinderDocs/$(id)).data.assignedTo);
        allow update, delete: if false;
      }

      match /events/{eid} {
        allow read: if isOffice();
        allow create: if isActive() && request.resource.data.actorId == request.auth.uid
                      && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // Reports read every signature at once (collection-group query); same audience as the per-document rule.
    match /{path=**}/signatures/{sid} {
      allow read: if isOffice();
    }

    // PDF form templates: everyone signed in reads the field list; office roles manage.
    match /formTemplates/{id} {
      allow read: if isActive();
      allow write: if isOffice();
    }

    // Completed forms. Staff create one for their own visit; the server fills in the trusted values and
    // builds the PDF. Nobody edits or deletes a submission from the app.
    match /formSubmissions/{id} {
      allow read: if isOffice() || (isActive() && resource.data.staffId == request.auth.uid);
      allow create: if isActive() && request.resource.data.staffId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['templateId', 'shiftId', 'clientId', 'staffId', 'values', 'status', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/shifts/$(request.resource.data.shiftId)).data.staffId == request.auth.uid;
      allow update, delete: if false;
    }

    // Name directory so staff can start chats (names and roles only; no contact details).
    match /directory/{uid} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Team chat: only members read or write. Messages are create-only and server-timestamped.
    match /chats/{id} {
      // Super admins can read every conversation for oversight.
      allow read: if isActive() && (request.auth.uid in resource.data.members || isSuper());
      // DSPs (staff, family staff) can only open a 1:1 chat with an office user, never with each other.
      allow create: if isActive() && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() <= 20
                    && (isOffice() || (request.resource.data.members.size() == 2
                        && get(/databases/$(database)/documents/directory/$(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0])).data.role in ['admin', 'super_admin', 'case_manager']));
      allow update: if isActive() && request.auth.uid in resource.data.members
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastAt']);
      match /messages/{mid} {
        allow read: if isActive() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members || isSuper());
        allow create: if isActive() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.members
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.at == request.time
                      && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // Residential units (homes and apartments). Everyone signed in reads them; the office manages them.
    // DSPs log safety checks, report maintenance and post unit messages, always as themselves.
    match /units/{id} {
      allow read: if isActive();
      allow write: if isOffice();
    }
    match /unitLogs/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.byId == request.auth.uid && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /unitRequests/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.byId == request.auth.uid && request.resource.data.status == 'open';
      allow update: if isOffice();
      allow delete: if false;
    }
    match /unitPosts/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.byId == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isOffice();
      allow update: if false;
    }

    // Required-training catalog: everyone signed in reads it; admins manage it.
    match /trainings/{id} {
      allow read: if isActive();
      allow write: if isOffice();
    }

    // Audit log: written only by Cloud Functions; admins read.
    match /auditLog/{id} {
      allow read: if isAdmin();
    }

    // Everything else is closed by default.
    match /{document=**} { allow read, write: if false; }
  }
}
