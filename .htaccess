# Single-page app: send every page address to index.html so reloading /admin/clients works.
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
# No caching of the entry page so updates show immediately.
<FilesMatch "index\.html$">
  Header set Cache-Control "no-store"
</FilesMatch>
